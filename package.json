{
  "title": "html2canvas",
  "name": "@html2canvas/html2canvas",
  "description": "Screenshots with JavaScript",
  "main": "dist/html2canvas.min.js",
  "module": "dist/html2canvas.module.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "browser": "dist/html2canvas.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/html2canvas.module.js",
      "require": "./dist/html2canvas.min.js",
      "default": "./dist/html2canvas.esm.js"
    }
  },
  "version": "1.8.0",
  "keywords": [
    "typescript",
    "html",
    "canvas",
    "html2canvas"
  ],
  "author": {
    "name": "Niklas von Hertzen",
    "email": "niklasvh@gmail.com",
    "url": "https://hertzen.com"
  },
  "contributors": [
    {
      "email": "zefling@ikilote.net",
      "name": "Zéfling",
      "url": "https://ikiw.fr/@Zefling"
    },
    {
      "email": "dev@cantoo.fr",
      "name": "Cantoo",
      "url": "https://cantoo.fr"
    }
  ],
  "engines": {
    "node": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:html2canvas/html2canvas.git"
  },
  "bugs": {
    "url": "https://github.com/html2canvas/html2canvas/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.6",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/karma": "^6.3.9",
    "@types/node": "^26.2.0",
    "@types/platform": "^1.3.4",
    "@types/promise-polyfill": "^6.0.4",
    "@types/serve-index": "^1.9.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "appium-ios-simulator": "^9.1.2",
    "base64-arraybuffer": "1.0.2",
    "browserslist": "^4.28.8",
    "cors": "^2.8.6",
    "es6-promise": "^4.2.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^4.18.2",
    "filenamify-url": "3.0.0",
    "glob": "^13.0.6",
    "jasmine-core": "^7.0.2",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.6.4",
    "jest-image-snapshot": "^6.5.2",
    "jquery": "^3.7.1",
    "js-polyfills": "^0.1.43",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.2",
    "karma-jasmine": "^5.1.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-safarinative-launcher": "^1.1.0",
    "node-simctl": "^9.1.1",
    "platform": "^1.3.6",
    "prettier": "^3.9.6",
    "puppeteer": "^25.8.0",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.5",
    "serve-index": "^1.9.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "yargs": "^18.1.0"
  },
  "scripts": {
    "prebuild": "rimraf dist/ && rimraf build/ && mkdir -p dist && mkdir -p build",
    "build": "tsc --project tsconfig.build.json --module commonjs && rollup -c rollup.config.js && npm run build:create-reftest-list && npm run build:testrunner",
    "build:testrunner": "webpack --config tests/webpack.config.js",
    "build:reftest-result-list": "ts-node scripts/create-reftest-result-list.ts",
    "build:create-reftest-list": "ts-node scripts/create-reftest-list.ts tests/reftests/ignore.txt build/reftests.ts",
    "build:reftest-preview": "node -e \"const fs=require('fs');const f='www/src/results.json';if(!fs.existsSync(f))fs.writeFileSync(f,'{}');\" && webpack --config www/webpack.config.cjs",
    "release": "npm run build && release-it",
    "publish": "npm publish --access public",
    "format": "prettier --write \"{src,www/src,tests,scripts}/**/*.ts\"",
    "lint": "eslint --max-warnings 0",
    "test": "npm run lint && npm run unittest && npm run karma",
    "unittest": "node node_modules/jest-cli/bin/jest.js --runInBand",
    "reftests-diff": "mkdir -p tmp/snapshots && jest --roots=tests --testMatch=**/reftest-diff.ts",
    "karma": "karma start",
    "watch": "rollup -c rollup.config.js --watch",
    "watch:unittest": "jest --watch src/**/__tests__/*.ts",
    "start": "ts-node --project tests/tsconfig.json tests/server --port=8080 --cors=8081 --screenshot=8000"
  },
  "license": "MIT",
  "dependencies": {
    "colorjs.io": "^0.7.1",
    "css-line-break": "^2.1.0",
    "text-segmentation": "^1.0.3"
  }
}

{
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "types": ["node", "jest"],
    "target": "es5",
    "lib": ["es2015", "es2022.intl", "dom"],
    "sourceMap": true,
    "outDir": "dist/lib",
    "declaration": true,
    "skipLibCheck": true,
    "declarationDir": "dist/types",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "build", "node_modules", "tests/testrunner.ts"]
}

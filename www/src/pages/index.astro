---
import {gzipSize} from 'gzip-size';
import {readFileSync} from 'node:fs';
import {resolve} from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Carbon from '../components/carbon.jsx';
import Footer from '../components/footer.jsx';

// Read gzip size of the minified bundle at build time
let packageSize = 0;
try {
    const minFile = readFileSync(resolve(process.cwd(), '../dist/html2canvas.min.js'));
    packageSize = await gzipSize(minFile);
} catch {
    // dist not built yet, default to 0
}

const sizeKb = Math.round(packageSize / 1024);

const codeStyle = {
    backgroundColor: '#7cb342',
    textShadow: '0 1px 0 rgba(23, 31, 35, 0.5)',
    color: '#fff',
    padding: '8px 16px',
    borderRadius: '3px',
    width: '100%',
    whiteSpace: 'pre-wrap',
    display: 'block',
    fontFamily: 'monospace'
};

const linkStyle = {
    padding: '4px 8px',
    margin: '10px',
    border: '2px solid #fff',
    color: '#fff',
    display: 'inline-block',
    textDecoration: 'none'
};
---

<BaseLayout title="html2canvas - Screenshots with JavaScript">
    <div
        style="background: #558b2f; background-image: linear-gradient(0deg, #558b2f, #7cb342); min-height: 100vh; display: flex; flex-direction: column;"
    >
        <div style="display: flex; flex-grow: 1;">
            <div
                style="max-width: 960px; color: #fff; margin: 0 auto; text-align: center; align-self: center; padding: 20px;"
            >
                <!-- Logo + title -->
                <div style="display: flex; align-items: center; justify-content: center;">
                    <img src="/logo_icon.svg" alt="html2canvas" />
                    <h1 style="color: #fff; margin-left: 12px;">html2canvas</h1>
                </div>
                <h4 style="color: rgba(255, 255, 255, 0.6); font-weight: 300;">Screenshots with JavaScript</h4>

                <!-- Code examples (desktop only) -->
                <div class="code-examples">
                    <div class="code-block">
                        <h4>HTML</h4>
                        <div style="margin-right: 5px;">
                            <pre
                                class="language-html"
                            ><code>&lt;div id="capture" style="padding: 10px; background: #f5da55"&gt;
  &lt;h4 style="color: #000;"&gt;Hello world!&lt;/h4&gt;
&lt;/div&gt;</code></pre>
                        </div>
                    </div>
                    <div class="code-block">
                        <h4>JavaScript</h4>
                        <div style="margin-left: 5px;">
                            <pre
                                class="language-javascript"
                            ><code>html2canvas(document.querySelector("#capture")).then(canvas => {'{'}
  document.body.appendChild(canvas)
{'}'});</code></pre>
                        </div>
                    </div>
                </div>

                <!-- CTAs -->
                <div style="margin: 20px;">
                    <a
                        href="/documentation"
                        style={linkStyle}
                        id="try-link"
                        onclick="event.preventDefault(); document.getElementById('tryhtml2canvas')?.click();"
                    >
                        Try it out
                    </a>
                    <a href="/documentation" style={linkStyle}>Documentation</a>
                </div>

                <!-- Cards -->
                <div class="cards">
                    <!-- Carbon ad -->
                    <div class="card">
                        <Carbon client:load />
                    </div>

                    <!-- Install -->
                    <div class="card" style="text-align: left;">
                        <h6>Install NPM</h6>
                        <code style={codeStyle}>npm install @html2canvas/html2canvas</code>
                        <h6>Install Yarn</h6>
                        <code style={codeStyle}>yarn add @html2canvas/html2canvas</code>
                        <div style="margin-top: 25px;">
                            <a href="/dist/html2canvas.js" style={linkStyle}>html2canvas.js</a>
                            <a href="/dist/html2canvas.min.js" style={linkStyle}>html2canvas.min.js</a>
                        </div>
                        {sizeKb > 0 && (
                            <div style="text-align: center; margin-top: 10px;">{sizeKb}kb gzipped</div>
                        )}
                    </div>

                    <!-- GitHub -->
                    <div class="card">
                        <h5>Connect</h5>
                        <div style="height: 35px;">
                            <iframe
                                title="Github"
                                src="https://ghbtns.com/github-btn.html?user=html2canvas&repo=html2canvas&type=fork&count=true&size=large"
                                frameborder="0"
                                scrolling="0"
                                width="160px"
                                height="30px"
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <Footer />
    </div>
</BaseLayout>

<style>
    .code-examples {
        display: none;
    }

    .cards {
        display: flex;
        flex-direction: column;
    }

    .card {
        flex: 1;
        background-color: #558b2f;
        padding: 10px 20px;
        border-radius: 10px;
        margin-bottom: 10px;
    }

    @media (min-width: 1000px) {
        .code-examples {
            display: flex;
            justify-content: center;
            flex-direction: row;
        }

        .code-block {
            display: block;
        }

        .cards {
            flex-direction: row;
        }

        .card + .card {
            margin-left: 5px;
        }

        .card:not(:last-child) {
            margin-right: 5px;
        }
    }
</style>

---
import { gzipSize } from 'gzip-size';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/footer.jsx';

// Read gzip size of the minified bundle at build time
let packageSize = 0;
try {
    const minFile = readFileSync(resolve(process.cwd(), '../dist/html2canvas.min.js'));
    packageSize = await gzipSize(minFile);
} catch {
    // dist not built yet, default to 0
}

// Badges shields.io — static SVG images, no JS, no iframe
const repo = 'html2canvas/html2canvas';
const npmPkg = '@html2canvas%2Fhtml2canvas';

const sizeKb = Math.round(packageSize / 1024);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="html2canvas - Screenshots with JavaScript">
    <div class="home-hero">
        <div class="home-hero-inner">
            <div class="home-hero-content">
                <!-- Logo + title -->
                <div class="home-logo">
                    <img src={`${base}/logo_icon.svg`} alt="html2canvas" />
                    <h1>html2canvas</h1>
                </div>
                <h4 class="home-subtitle">Screenshots with JavaScript</h4>

                <!-- Code examples (desktop only) -->
                <div class="code-examples">
                    <div class="code-block">
                        <h4>HTML</h4>
                        <div class="code-block-left">
                            <pre
                                class="language-html"><code>&lt;div id="capture" style="padding: 10px; background: #f5da55"&gt;
  &lt;h4 style="color: #000;"&gt;Hello world!&lt;/h4&gt;
&lt;/div&gt;</code></pre>
                        </div>
                    </div>
                    <div class="code-block">
                        <h4>JavaScript</h4>
                        <div class="code-block-right">
                            <pre
                                class="language-javascript"><code>html2canvas(document.querySelector("#capture")).then(canvas => {'{'}
  document.body.appendChild(canvas)
{'}'});</code></pre>
                        </div>
                    </div>
                </div>

                <!-- CTAs -->
                <div class="home-ctas">
                    <a
                        href={`${base}/documentation`}
                        class="home-link"
                        id="try-link"
                        onclick="event.preventDefault(); document.getElementById('tryhtml2canvas')?.click();"
                    >
                        Try it out
                    </a>
                    <a href={`${base}/documentation`} class="home-link">Documentation</a>
                </div>

                <!-- Cards -->
                <div class="cards">
                    <!-- Install -->
                    <div class="card card-install">
                        <h6>Install NPM</h6>
                        <code class="card-code">npm install @html2canvas/html2canvas</code>
                        <h6>Install Yarn</h6>
                        <code class="card-code">yarn add @html2canvas/html2canvas</code>
                        <div class="card-downloads">
                            <a href={`${base}/dist/html2canvas.js`} class="home-link">html2canvas.js</a>
                            <a href={`${base}/dist/html2canvas.min.js`} class="home-link">html2canvas.min.js</a>
                        </div>
                        {sizeKb > 0 && <div class="card-size">{sizeKb}kb gzipped</div>}
                    </div>

                    <!-- GitHub / npm badges -->
                    <div class="card">
                        <h5>Project</h5>
                        <div class="badges">
                            <a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer">
                                <img
                                    src={`https://img.shields.io/github/stars/${repo}?style=social`}
                                    alt="GitHub Stars"
                                />
                            </a>
                            <a
                                href={`https://github.com/${repo}/network/members`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img
                                    src={`https://img.shields.io/github/forks/${repo}?style=social`}
                                    alt="GitHub Forks"
                                />
                            </a>
                            <a
                                href={`https://www.npmjs.com/package/${npmPkg}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img src={`https://img.shields.io/npm/v/${npmPkg}`} alt="npm version" />
                            </a>
                            <a
                                href={`https://www.npmjs.com/package/${npmPkg}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img src={`https://img.shields.io/npm/dm/${npmPkg}`} alt="npm downloads" />
                            </a>
                            <a
                                href={`https://github.com/${repo}/blob/master/LICENSE.md`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img
                                    src="https://img.shields.io/github/license/html2canvas/html2canvas"
                                    alt="License"
                                />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <Footer />
    </div>
</BaseLayout>

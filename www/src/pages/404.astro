---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 - Page not found | html2canvas">
    <div
        style="min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; font-family: Roboto, sans-serif;"
    >
        <h1 style="font-size: 6rem; margin: 0; color: #558b2f;">404</h1>
        <p style="color: rgba(0,0,0,0.6); font-size: 1.2rem;">
            You just hit a route that doesn't exist... the sadness.
        </p>
        <a
            href={`${base}/`}
            style="margin-top: 20px; padding: 8px 20px; background: #7cb342; color: #fff; border-radius: 3px; text-decoration: none;"
        >
            Back to home
        </a>
    </div>
</BaseLayout>

---
import {readFileSync, readdirSync} from 'node:fs';
import {resolve, basename} from 'node:path';
import matter from 'gray-matter';
import {parseMarkdown} from '../utils/markdown';
import DocsLayout from '../layouts/DocsLayout.astro';

// Build-time: generate one route per .md file in docs/
export async function getStaticPaths() {
    const docsDir = resolve(process.cwd(), '../docs');
    const files = readdirSync(docsDir).filter((f) => f.endsWith('.md'));

    return files.map((file) => {
        const slug = basename(file, '.md');
        return {params: {slug}};
    });
}

// Resolve relative prev/next URLs like "./getting-started" → "/getting-started"
function resolveDocUrl(url?: string): string | undefined {
    if (!url) return undefined;
    return url.replace(/^\.\//, '/');
}

const {slug} = Astro.params;
const docsDir = resolve(process.cwd(), '../docs');
const filePath = resolve(docsDir, `${slug}.md`);

const raw = readFileSync(filePath, 'utf-8');
const {data: frontmatter, content} = matter(raw);

const html = await parseMarkdown(content);

const title = frontmatter.title ?? slug;
const description = frontmatter.description ?? '';
const previousUrl = resolveDocUrl(frontmatter.previousUrl);
const previousTitle = frontmatter.previousTitle;
const nextUrl = resolveDocUrl(frontmatter.nextUrl);
const nextTitle = frontmatter.nextTitle;
---

<DocsLayout
    title={title}
    description={description}
    previousUrl={previousUrl}
    previousTitle={previousTitle}
    nextUrl={nextUrl}
    nextTitle={nextTitle}
>
    <Fragment set:html={html} />
</DocsLayout>

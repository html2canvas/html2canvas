---
import Footer from '../components/footer.jsx';
import Navigation from '../components/navigation.jsx';
import back from '../images/ic_arrow_back_black_24px.svg?raw';
import next from '../images/ic_arrow_forward_black_24px.svg?raw';
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    description?: string;
    previousUrl?: string;
    previousTitle?: string;
    nextUrl?: string;
    nextTitle?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { title, description = '', previousUrl, previousTitle, nextUrl, nextTitle } = Astro.props;

const hasPrev = previousUrl && previousTitle;
const hasNext = nextUrl && nextTitle;
const hasPagination = hasPrev || hasNext;
---

<BaseLayout title={`${title} - html2canvas`} description={description}>
    <Navigation client:load base={base} />

    <div class="docs-wrapper">
        <!-- Page header -->
        <div class="docs-header">
            <div class="docs-header-inner">
                <div class="docs-header-row">
                    <div class="docs-header-text">
                        <h1 class="docs-title">{title}</h1>
                        <h4 class="docs-desc">{description}</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="docs-body">
            <div class="docs-content">
                <slot />
            </div>
        </div>

        <!-- Pagination -->
        {
            hasPagination && (
                <div class="docs-pagination">
                    <div class="docs-pagination-inner">
                        {hasPrev && (
                            <a href={`${base}${previousUrl}`} class="docs-pagination-link">
                                <div class="docs-pagination-icon" set:html={back} />
                                <div>
                                    <span class="docs-pagination-label">Previous</span>
                                    <div class="docs-pagination-title">{previousTitle}</div>
                                </div>
                            </a>
                        )}
                        {hasNext && (
                            <a href={`${base}${nextUrl}`} class="docs-pagination-link docs-pagination-link--next">
                                <div>
                                    <span class="docs-pagination-label">Next</span>
                                    <div class="docs-pagination-title">{nextTitle}</div>
                                </div>
                                <div class="docs-pagination-icon" set:html={next} />
                            </a>
                        )}
                    </div>
                </div>
            )
        }

        <Footer />
    </div>
</BaseLayout>
